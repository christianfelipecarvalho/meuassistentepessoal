{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-var": "error",
    "no-console": "off",
    "eqeqeq": "error",
    "curly": ["error", "all"]
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "dist/"
  ]
}
